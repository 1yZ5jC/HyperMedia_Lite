<Page
    x:Class="HyperMedia_Lite.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HyperMedia_Lite"
    xmlns:models="using:HyperMedia_Lite.Models"
    xmlns:helpers="using:HyperMedia_Lite.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:BoolToAccentBrushConverter x:Key="BoolToAccentBrush"/>

        <!-- 左侧导航项容器 -->
        <Style x:Key="NavItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 媒体卡片容器 -->
        <Style x:Key="AlbumItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 播放条图标按钮 -->
        <Style x:Key="PlaybackIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 主体区域 ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Grid Grid.Column="0" Background="{StaticResource NavBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                    <Button
                        x:Name="BackButton"
                        Width="48"
                        Height="48"
                        Margin="6,0,0,8"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        AutomationProperties.Name="返回">
                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                    </Button>
                    <Button
                        x:Name="HamburgerButton"
                        Width="48"
                        Height="48"
                        Margin="6,0,0,8"
                        Background="#FFEDEDED"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0"
                        AutomationProperties.Name="菜单">
                        <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                    </Button>
                </StackPanel>

                <ListView
                    x:Name="NavList"
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    ItemsSource="{Binding NavItems}"
                    ItemContainerStyle="{StaticResource NavItemStyle}"
                    IsItemClickEnabled="True"
                    SelectionMode="None"
                    ItemClick="NavList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NavItem">
                            <Grid Width="92" Height="56">
                                <Rectangle
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="3"
                                    Height="30"
                                    Fill="{StaticResource AccentBrush}"
                                    Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Glyph="{x:Bind Glyph}"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="{x:Bind IsSelected, Converter={StaticResource BoolToAccentBrush}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button
                    x:Name="SettingsButton"
                    Grid.Row="2"
                    Width="48"
                    Height="48"
                    Margin="22,0,0,16"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="{StaticResource NavForegroundBrush}"
                    BorderThickness="0"
                    AutomationProperties.Name="设置">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                </Button>
            </Grid>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="32,24,32,0">
                    <TextBlock
                        Text="我的音乐"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- 选项卡（歌曲 / 歌手 / 专辑） -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button
                            x:Name="TabSongs"
                            Tag="0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="Tab_Click"
                            AutomationProperties.Name="歌曲">
                            <StackPanel>
                                <TextBlock Text="歌曲" FontSize="16"/>
                                <Rectangle x:Name="UnderlineSongs" Height="2" Margin="0,4,0,0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="TabArtists"
                            Tag="1"
                            Margin="28,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="Tab_Click"
                            AutomationProperties.Name="歌手">
                            <StackPanel>
                                <TextBlock Text="歌手" FontSize="16"/>
                                <Rectangle x:Name="UnderlineArtists" Height="2" Margin="0,4,0,0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="TabAlbums"
                            Tag="2"
                            Margin="28,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="Tab_Click"
                            AutomationProperties.Name="专辑">
                            <StackPanel>
                                <TextBlock Text="专辑" FontSize="16"/>
                                <Rectangle x:Name="UnderlineAlbums" Height="2" Margin="0,4,0,0" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 工具条 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.Name="无序播放所有">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                <TextBlock Text="{Binding PlayAllText}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="24,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            AutomationProperties.Name="排序依据">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="排序依据:"/>
                                <TextBlock Text="{Binding SortDescription}" Margin="6,0,0,0" Foreground="{StaticResource AccentBrush}"/>
                                <FontIcon Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 空状态（歌曲 / 歌手） -->
                <Grid x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed">
                    <TextBlock
                        Text="这里没有可显示的内容。请尝试其他筛选器。"
                        FontSize="15"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="36,48,0,0"/>
                </Grid>

                <!-- 专辑网格 -->
                <GridView
                    x:Name="AlbumGrid"
                    Grid.Row="1"
                    Padding="28,20,28,16"
                    ItemsSource="{Binding Albums}"
                    ItemContainerStyle="{StaticResource AlbumItemStyle}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaCard">
                            <Grid Width="180" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{x:Bind CoverBrush}">
                                    <TextBlock
                                        Text="{x:Bind Initial}"
                                        FontSize="64"
                                        Foreground="#59FFFFFF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="4,8,4,0">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock
                                        Text="{x:Bind Subtitle}"
                                        FontSize="12"
                                        Margin="0,2,0,0"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>

        <!-- ==================== 底部常驻播放条 ==================== -->
        <Grid Grid.Row="1" Background="{StaticResource AccentBrush}" Height="96" Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 封面 + 曲名 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="56" Height="56" Background="#CCFFFFFF">
                    <TextBlock
                        Text="二"
                        FontSize="24"
                        Foreground="{StaticResource AccentBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding TrackTitle}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding TrackArtist}" FontSize="12" Foreground="#DDFFFFFF"/>
                </StackPanel>
            </StackPanel>

            <!-- 传输控制 + 进度 -->
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" AutomationProperties.Name="随机播放">
                        <FontIcon Glyph="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0" AutomationProperties.Name="上一首">
                        <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                    </Button>
                    <Button
                        Style="{StaticResource PlaybackIconButtonStyle}"
                        Width="48"
                        Height="48"
                        Margin="18,0,0,0"
                        AutomationProperties.Name="播放">
                        <Grid Width="40" Height="40">
                            <Ellipse Stroke="White" StrokeThickness="1.5"/>
                            <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0" AutomationProperties.Name="下一首">
                        <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                    </Button>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0" AutomationProperties.Name="循环">
                        <FontIcon Glyph="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" FontSize="11" Foreground="White" Margin="0,0,8,0"/>
                    <Slider Grid.Column="1" VerticalAlignment="Center" Value="85" Maximum="359" Foreground="White" Background="#66FFFFFF"/>
                    <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" FontSize="11" Foreground="White" Margin="8,0,0,0"/>
                </Grid>
            </Grid>

            <!-- 音量 / 歌词 / 更多 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                <Slider Width="120" VerticalAlignment="Center" Value="70" Maximum="100" Margin="14,0,0,0" Foreground="White" Background="#66FFFFFF"/>
                <Button Style="{StaticResource PlaybackIconButtonStyle}" Width="32" Margin="14,0,0,0" AutomationProperties.Name="歌词">
                    <TextBlock Text="词" FontSize="14" Foreground="White"/>
                </Button>
                <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="14,0,0,0" AutomationProperties.Name="更多">
                    <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
