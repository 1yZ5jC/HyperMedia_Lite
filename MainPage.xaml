<Page
    x:Class="HyperMedia_Lite.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HyperMedia_Lite.Models"
    xmlns:helpers="using:HyperMedia_Lite.Helpers"
    xmlns:controls="using:HyperMedia_Lite.Controls"
    xmlns:vm="using:HyperMedia_Lite.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:MediaKindToVisibilityConverter x:Key="MediaKindToVisibility"/>
        <helpers:BoolToAccentBrushConverter x:Key="BoolToAccentBrush"/>
        <helpers:BoolToTextBrushConverter x:Key="BoolToTextBrush"/>
        <helpers:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <helpers:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
        <helpers:BoolToFontSizeConverter x:Key="BoolToFontSizeConverter"/>
        <helpers:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <helpers:BoolToLyricBrushConverter x:Key="BoolToLyricBrushConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:TextToVisibilityConverter x:Key="TextToVisibility"/>

        <!-- 媒体库右键菜单（须先于引用它的模板定义） -->
        <MenuFlyout x:Key="MediaContextMenu">
            <MenuFlyoutItem Text="播放" Click="ContextPlay_Click"/>
            <MenuFlyoutItem Text="加入播放队列" Click="ContextQueue_Click"
                            Visibility="{Binding Kind, Converter={StaticResource MediaKindToVisibility}, ConverterParameter='Audio,Video'}"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="编辑音乐信息" Click="EditMetadata_Click"
                            Visibility="{Binding Kind, Converter={StaticResource MediaKindToVisibility}, ConverterParameter=Audio}"/>
            <MenuFlyoutItem Text="编辑图片" Click="ContextEditPhoto_Click"
                            Visibility="{Binding Kind, Converter={StaticResource MediaKindToVisibility}, ConverterParameter=Photo}"/>
            <MenuFlyoutItem Text="设为磁贴轮播" Click="ContextTile_Click"
                            Visibility="{Binding Kind, Converter={StaticResource MediaKindToVisibility}, ConverterParameter=Photo}"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="{Binding FavoriteLabel}" Click="ContextFavorite_Click"/>
            <MenuFlyoutItem Text="从媒体库移除" Click="ContextRemove_Click"/>
        </MenuFlyout>

        <DataTemplate x:Key="SongAlbumHeaderTemplate">
            <TextBlock Text="{Binding Album}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,10,0,4"/>
        </DataTemplate>
        <DataTemplate x:Key="SongItemTemplate" x:DataType="models:MediaItem">
            <Grid Height="48" Padding="8,0">
                <Grid.ContextFlyout>
                    <StaticResource ResourceKey="MediaContextMenu"/>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Title, Mode=OneWay}" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Album, Mode=OneWay}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{x:Bind DurationText, Mode=OneWay}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,4,0"/>
            </Grid>
        </DataTemplate>
        <helpers:SongRowTemplateSelector x:Key="SongRowSelector"
                                         HeaderTemplate="{StaticResource SongAlbumHeaderTemplate}"
                                         ItemTemplate="{StaticResource SongItemTemplate}"/>

        <Style x:Key="NavItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="CardItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SongItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 深色浮层上的图标按钮：悬停不再变黑，而是浅色半透明反馈 -->
        <Style x:Key="OverlayIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#33FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#55FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放顺序按钮：悬停用浅色半透明，避免默认模板的黑色阴影 -->
        <Style x:Key="PlayerModeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#33FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#55FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaybackIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonRoot.Background" Value="#33FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonRoot.Background" Value="#55FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonRoot.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource PageBackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <!-- 极窄 (<420)：只保留核心操作，其余全部进「更多」菜单 -->
                <VisualState x:Name="TinyLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderPanel.Padding" Value="8,12,8,0"/>
                        <Setter Target="PageTitleText.FontSize" Value="20"/>
                        <Setter Target="AudioPanel.Margin" Value="12,64,12,140"/>
                        <Setter Target="WideLyricLayout.Visibility" Value="Collapsed"/>
                        <Setter Target="NarrowLyricLayout.Visibility" Value="Visible"/>
                        <Setter Target="SortComboBox.Visibility" Value="Collapsed"/>
                        <Setter Target="ShuffleAllText.Visibility" Value="Collapsed"/>
                        <Setter Target="RefreshButton.Visibility" Value="Collapsed"/>
                        <Setter Target="AddFolderButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PlayerBar.Height" Value="72"/>
                        <Setter Target="PlayerCoverButton.Width" Value="72"/>
                        <Setter Target="PlayerContent.Padding" Value="6,2,6,2"/>
                        <Setter Target="PlayButton.Width" Value="32"/>
                        <Setter Target="PlayButton.Height" Value="32"/>
                        <Setter Target="PlayIconGrid.Width" Value="28"/>
                        <Setter Target="PlayIconGrid.Height" Value="28"/>
                        <Setter Target="PlayerProgressRow.Margin" Value="0,2,0,0"/>
                        <Setter Target="PlayerTitlePanel.Visibility" Value="Collapsed"/>
                        <Setter Target="ModeButton.Width" Value="40"/>
                        <Setter Target="PlayerTransport.Margin" Value="0"/>
                        <Setter Target="PrevButton.Margin" Value="4,0,0,0"/>
                        <Setter Target="PlayButton.Margin" Value="4,0,0,0"/>
                        <Setter Target="NextButton.Margin" Value="4,0,0,0"/>
                        <Setter Target="VolumePanel.Visibility" Value="Visible"/>
                        <Setter Target="VolumeSlider.Width" Value="36"/>
                        <Setter Target="NowPlayingRateButton.Visibility" Value="Collapsed"/>
                        <Setter Target="NowPlayingFullscreenButton.Visibility" Value="Visible"/>
                        <Setter Target="NowPlayingMoreButton.Visibility" Value="Visible"/>
                        <Setter Target="MoreButton.Visibility" Value="Collapsed"/>
                        <Setter Target="AlbumGrid.Padding" Value="4,6,4,12"/>
                        <Setter Target="SongList.Padding" Value="4,6,4,12"/>
                        <Setter Target="ArtistGrid.Padding" Value="4,6,4,12"/>
                        <Setter Target="GenericGrid.Padding" Value="4,6,4,12"/>
                        <Setter Target="ZoomSlider.Width" Value="60"/>
                        <Setter Target="PhotoTitle.MaxWidth" Value="90"/>
                        <Setter Target="PhotoRotateBackButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoRotateButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoInfoButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoEditButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoSlideButton.Visibility" Value="Collapsed"/>
                        <Setter Target="FlipHButton.Visibility" Value="Collapsed"/>
                        <Setter Target="FlipVButton.Visibility" Value="Collapsed"/>
                        <Setter Target="HeaderOverflowButton.Visibility" Value="Visible"/>
                        <Setter Target="PlayerOverflowButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoOverflowButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- 窄 (420–640)：保留曲目信息与缩小后的音量条 -->
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="420"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderPanel.Padding" Value="12,16,12,0"/>
                        <Setter Target="PageTitleText.FontSize" Value="22"/>
                        <Setter Target="AudioPanel.Margin" Value="16,64,16,140"/>
                        <Setter Target="WideLyricLayout.Visibility" Value="Collapsed"/>
                        <Setter Target="NarrowLyricLayout.Visibility" Value="Visible"/>
                        <Setter Target="SortComboBox.Visibility" Value="Collapsed"/>
                        <Setter Target="ShuffleAllText.Visibility" Value="Collapsed"/>
                        <Setter Target="RefreshButton.Visibility" Value="Collapsed"/>
                        <Setter Target="AddFolderButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PlayerBar.Height" Value="80"/>
                        <Setter Target="PlayerCoverButton.Width" Value="80"/>
                        <Setter Target="PlayerContent.Padding" Value="8,4,8,4"/>
                        <Setter Target="PlayButton.Width" Value="36"/>
                        <Setter Target="PlayButton.Height" Value="36"/>
                        <Setter Target="PlayIconGrid.Width" Value="32"/>
                        <Setter Target="PlayIconGrid.Height" Value="32"/>
                        <Setter Target="PlayerProgressRow.Margin" Value="0,4,0,0"/>
                        <Setter Target="PlayerTitlePanel.Visibility" Value="Collapsed"/>
                        <Setter Target="ModeButton.Width" Value="40"/>
                        <Setter Target="PlayerTransport.Margin" Value="4,0"/>
                        <Setter Target="PlayerModeText.Visibility" Value="Collapsed"/>
                        <Setter Target="PrevButton.Margin" Value="6,0,0,0"/>
                        <Setter Target="PlayButton.Margin" Value="6,0,0,0"/>
                        <Setter Target="NextButton.Margin" Value="6,0,0,0"/>
                        <Setter Target="VolumeSlider.Width" Value="52"/>
                        <Setter Target="NowPlayingRateButton.Visibility" Value="Collapsed"/>
                        <Setter Target="NowPlayingFullscreenButton.Visibility" Value="Visible"/>
                        <Setter Target="NowPlayingMoreButton.Visibility" Value="Visible"/>
                        <Setter Target="MoreButton.Visibility" Value="Collapsed"/>
                        <Setter Target="AlbumGrid.Padding" Value="8,8,8,16"/>
                        <Setter Target="SongList.Padding" Value="8,8,8,16"/>
                        <Setter Target="ArtistGrid.Padding" Value="8,8,8,16"/>
                        <Setter Target="GenericGrid.Padding" Value="8,8,8,16"/>
                        <Setter Target="ZoomSlider.Width" Value="80"/>
                        <Setter Target="PhotoTitle.MaxWidth" Value="140"/>
                        <Setter Target="PhotoRotateBackButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoInfoButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoEditButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoSlideButton.Visibility" Value="Collapsed"/>
                        <Setter Target="FlipHButton.Visibility" Value="Collapsed"/>
                        <Setter Target="FlipVButton.Visibility" Value="Collapsed"/>
                        <Setter Target="HeaderOverflowButton.Visibility" Value="Visible"/>
                        <Setter Target="PlayerOverflowButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoOverflowButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- 中等窗口：保留主要控件，收紧间距 -->
                <VisualState x:Name="MediumLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderPanel.Padding" Value="20,20,20,0"/>
                        <Setter Target="PlayerTransport.Margin" Value="12,0"/>
                        <Setter Target="NowPlayingCover.Width" Value="220"/>
                        <Setter Target="NowPlayingCover.Height" Value="220"/>
                        <Setter Target="NowPlayingArt.MaxWidth" Value="240"/>
                        <Setter Target="MoreButton.Visibility" Value="Collapsed"/>
                        <Setter Target="AlbumGrid.Padding" Value="16,12,16,16"/>
                        <Setter Target="SongList.Padding" Value="16,12,16,16"/>
                        <Setter Target="ArtistGrid.Padding" Value="16,12,16,16"/>
                        <Setter Target="GenericGrid.Padding" Value="16,12,16,16"/>
                        <Setter Target="HeaderOverflowButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PlayerOverflowButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoOverflowButton.Visibility" Value="Collapsed"/>
                        <Setter Target="ModeButton.Width" Value="96"/>
                        <Setter Target="NowPlayingRateButton.Visibility" Value="Visible"/>
                        <Setter Target="NowPlayingFullscreenButton.Visibility" Value="Visible"/>
                        <Setter Target="NowPlayingMoreButton.Visibility" Value="Collapsed"/>
                        <Setter Target="WideLyricLayout.Visibility" Value="Visible"/>
                        <Setter Target="NarrowLyricLayout.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoTitle.MaxWidth" Value="260"/>
                        <Setter Target="PhotoRotateBackButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoRotateButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoInfoButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoEditButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoSlideButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1024"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderOverflowButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PlayerOverflowButton.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoOverflowButton.Visibility" Value="Collapsed"/>
                        <Setter Target="ModeButton.Width" Value="96"/>
                        <Setter Target="NowPlayingRateButton.Visibility" Value="Visible"/>
                        <Setter Target="NowPlayingFullscreenButton.Visibility" Value="Visible"/>
                        <Setter Target="NowPlayingMoreButton.Visibility" Value="Collapsed"/>
                        <Setter Target="WideLyricLayout.Visibility" Value="Visible"/>
                        <Setter Target="NarrowLyricLayout.Visibility" Value="Collapsed"/>
                        <Setter Target="PhotoTitle.MaxWidth" Value="260"/>
                        <Setter Target="PhotoRotateBackButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoRotateButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoInfoButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoEditButton.Visibility" Value="Visible"/>
                        <Setter Target="PhotoSlideButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 自定义标题栏：右侧预留系统按钮空间，播放时变黑 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Height="32"
              Padding="16,0,140,0" Background="{StaticResource SurfaceBrush}">
            <TextBlock x:Name="AppTitleText" Text="HyperMedia" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- ==================== 左侧窄导航栏（Groove 风格） ==================== -->
        <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource NavBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,8,0,0">
                <Button Width="40" Height="40" Margin="16,0,0,0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="Hamburger_Click" AutomationProperties.Name="菜单">
                    <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                </Button>
                <Button Width="40" Height="40" Margin="16,6,0,0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="Search_Click" AutomationProperties.Name="搜索">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                </Button>
            </StackPanel>

            <ListView x:Name="RailList" Grid.Row="1" Margin="0,12,0,0"
                      ItemsSource="{Binding NavItems}"
                      ItemContainerStyle="{StaticResource NavItemStyle}"
                      SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="NavList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:NavItem">
                        <Grid Width="72" Height="44">
                            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Width="3" Height="22" Fill="{StaticResource AccentBrush}"
                                       Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Glyph="{x:Bind Glyph, Mode=OneWay}"
                                      FontFamily="Segoe MDL2 Assets" FontSize="20"
                                      Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2" Width="40" Height="40" Margin="16,0,0,12" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource NavForegroundBrush}"
                    Click="Settings_Click" AutomationProperties.Name="设置">
                <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
            </Button>
        </Grid>

        <!-- ==================== 内容区 ==================== -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：标题 / 选项卡 / 工具条 -->
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Padding="32,24,32,0" Background="{StaticResource SurfaceBrush}">
                <TextBlock x:Name="PageTitleText" Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding ShowMusicTabs, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabSongs" Tag="0" Padding="0" BorderThickness="0"
                                Background="Transparent" Click="Tab_Click"
                                Foreground="{Binding IsSongsVisible, Converter={StaticResource BoolToTextBrush}}"
                                AutomationProperties.Name="歌曲">
                            <StackPanel>
                                <TextBlock Text="歌曲" FontSize="16"/>
                                <Rectangle Height="2" Margin="0,6,0,0" Fill="{StaticResource AccentBrush}"
                                           Visibility="{Binding IsSongsVisible, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabArtists" Tag="1" Margin="28,0,0,0" Padding="0" BorderThickness="0"
                                Background="Transparent" Click="Tab_Click"
                                Foreground="{Binding IsArtistsVisible, Converter={StaticResource BoolToTextBrush}}"
                                AutomationProperties.Name="歌手">
                            <StackPanel>
                                <TextBlock Text="歌手" FontSize="16"/>
                                <Rectangle Height="2" Margin="0,6,0,0" Fill="{StaticResource AccentBrush}"
                                           Visibility="{Binding IsArtistsVisible, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabAlbums" Tag="2" Margin="28,0,0,0" Padding="0" BorderThickness="0"
                                Background="Transparent" Click="Tab_Click"
                                Foreground="{Binding IsAlbumsVisible, Converter={StaticResource BoolToTextBrush}}"
                                AutomationProperties.Name="专辑">
                            <StackPanel>
                                <TextBlock Text="专辑" FontSize="16"/>
                                <Rectangle Height="2" Margin="0,6,0,0" Fill="{StaticResource AccentBrush}"
                                           Visibility="{Binding IsAlbumsVisible, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="20,-4,0,0" Padding="6,2" BorderThickness="0"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                Command="{Binding ClearArtistFilterCommand}"
                                Visibility="{Binding HasArtistFilter, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="清除歌手筛选">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ArtistFilter}" FontSize="12"/>
                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Rectangle Height="1" Fill="#FFE4E4E4" Margin="0,10,0,0"
                           Visibility="{Binding ShowMusicTabs, Converter={StaticResource BoolToVisibility}}"/>

                <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Command="{Binding ShuffleAllCommand}"
                                AutomationProperties.Name="无序播放所有">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                <TextBlock x:Name="ShuffleAllText" Text="{Binding PlayAllText}" Margin="8,0,0,0" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="SortComboBox" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                                  Height="30" MinWidth="100" Margin="0,0,8,0"
                                  AutomationProperties.Name="排序方式"/>
                        <Button x:Name="RefreshButton" Width="32" Height="30" Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Command="{Binding RefreshCommand}" AutomationProperties.Name="刷新媒体库">
                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Width="32" Height="30" Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Command="{Binding AddFilesCommand}" AutomationProperties.Name="添加媒体">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button Width="32" Height="30" Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Visibility="{Binding IsPlaylistsVisible, Converter={StaticResource BoolToVisibility}}"
                                Click="CreatePlaylist_Click" AutomationProperties.Name="新建播放列表">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button x:Name="AddFolderButton" Width="32" Height="30" Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Command="{Binding AddFolderCommand}" AutomationProperties.Name="导入文件夹">
                            <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button x:Name="HeaderOverflowButton" Width="32" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                Visibility="Collapsed" AutomationProperties.Name="更多选项">
                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="刷新媒体库" Command="{Binding RefreshCommand}"/>
                                    <MenuFlyoutItem Text="导入文件夹" Command="{Binding AddFolderCommand}"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="按标题排序" Click="SetSortTitle_Click"/>
                                    <MenuFlyoutItem Text="按最近添加排序" Click="SetSortDate_Click"/>
                                    <MenuFlyoutItem Text="按时长排序" Click="SetSortDuration_Click"/>
                                    <MenuFlyoutItem Text="按专辑排序" Click="SetSortAlbum_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 主体：专辑 / 歌曲 / 歌手 / 通用视图 -->
            <Grid Grid.Row="1" Background="{StaticResource SurfaceBrush}">

                <!-- 专辑 -->
                <GridView x:Name="AlbumGrid" Padding="28,8,28,20"
                          ItemsSource="{Binding Albums}" ItemContainerStyle="{StaticResource CardItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AlbumGrid_ItemClick"
                          Visibility="{Binding IsAlbumsVisible, Converter={StaticResource BoolToVisibility}}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlbumCard">
                            <Grid Width="200" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{x:Bind FallbackBrush, Mode=OneWay}">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="72"
                                                   Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasThumbnail, Mode=OneWay, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                               Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Height="38"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 歌曲 -->
                <ListView x:Name="SongList" Padding="28,8,28,20"
                          ItemsSource="{Binding SongRows}"
                          ItemTemplateSelector="{StaticResource SongRowSelector}"
                          ItemContainerStyle="{StaticResource SongItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="SongList_ItemClick"
                          Visibility="{Binding IsSongsVisible, Converter={StaticResource BoolToVisibility}}">
                </ListView>

                <!-- 歌手 -->
                <GridView x:Name="ArtistGrid" Padding="28,8,28,20"
                          ItemsSource="{Binding Artists}" ItemContainerStyle="{StaticResource CardItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ArtistGrid_ItemClick"
                          Visibility="{Binding IsArtistsVisible, Converter={StaticResource BoolToVisibility}}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:ArtistCard">
                            <Grid Width="180" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{x:Bind FallbackBrush, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="72"
                                               Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind SongCountText, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 视频 / 图片 / 收藏 / 队列 / 最近 -->
                <GridView x:Name="GenericGrid" Padding="28,8,28,20"
                          ItemsSource="{Binding CurrentItems}" ItemContainerStyle="{StaticResource CardItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="MediaGrid_ItemClick"
                          Visibility="{Binding IsGenericVisible, Converter={StaticResource BoolToVisibility}}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <Grid Width="180" Margin="6">
                                <Grid.ContextFlyout>
                                    <StaticResource ResourceKey="MediaContextMenu"/>
                                </Grid.ContextFlyout>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{x:Bind FallbackBrush, Mode=OneWay}">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="64"
                                                   Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasThumbnail, Mode=OneWay, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                               Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Width="30" Height="30" Padding="0" Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="#99000000" BorderThickness="0"
                                                Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"
                                                Click="Favorite_Click" AutomationProperties.Name="收藏">
                                            <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </Button>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="#CC000000" Padding="6,2" Margin="0,0,4,4"
                                                Visibility="{x:Bind DurationText, Mode=OneWay, Converter={StaticResource TextToVisibility}}">
                                            <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 播放列表 -->
                <GridView x:Name="PlaylistGrid" Padding="28,8,28,20"
                          ItemsSource="{Binding Playlists}" ItemContainerStyle="{StaticResource CardItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Playlist_ItemClick"
                          Visibility="{Binding IsPlaylistsVisible, Converter={StaticResource BoolToVisibility}}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <Grid Width="200" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FF2A3A44" Padding="12">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                                  FontSize="40" Foreground="#AAFFFFFF"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Width="32" Height="32" Padding="0" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Background="#99000000" BorderThickness="0"
                                                Foreground="White" Click="DeletePlaylist_Click"
                                                ToolTipService.ToolTip="删除" AutomationProperties.Name="删除">
                                            <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 统计 -->
                <Grid Visibility="{Binding IsStatsVisible, Converter={StaticResource BoolToVisibility}}"
                      Background="{StaticResource SurfaceBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                  Foreground="{StaticResource NavForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="媒体统计" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding StatsText}" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 空状态 -->
                <Grid Background="{StaticResource SurfaceBrush}"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                  Foreground="{StaticResource NavForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="这里还没有媒体" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,20"/>
                        <Button Content="添加媒体" HorizontalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                BorderThickness="0" Padding="20,6" Command="{Binding AddFilesCommand}"/>
                    </StackPanel>
                </Grid>

                <ProgressBar VerticalAlignment="Top" Height="3" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <!-- ==================== 底部播放条 ==================== -->
            <!-- 迷你播放器始终常驻；未播放时控件保持可用但无内容 -->
            <!-- 高度自适应：两行内容（控制 + 整行进度）在任何宽度下都不会被裁切 -->
            <Grid x:Name="PlayerBar" Grid.Row="2" Height="96" Background="{StaticResource AccentBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 全高封面：占据播放条整个高度 -->
                <Button x:Name="PlayerCoverButton" Width="96" Padding="0" BorderThickness="0"
                        Background="Transparent" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" VerticalAlignment="Stretch"
                        Click="OpenPlayer_Click" AutomationProperties.Name="展开播放页面">
                    <Border x:Name="PlayerCoverBorder" Background="{Binding TrackFallbackBrush}">
                        <Grid>
                            <TextBlock Text="{Binding TrackInitial}" FontSize="32" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasTrackThumbnail, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Source="{Binding TrackThumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding HasTrackThumbnail, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                </Button>

                <!-- 右侧控制区：上排控制 + 下排整行进度 -->
                <Grid x:Name="PlayerContent" Grid.Column="1" Padding="16,8,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="PlayerTitlePanel" Grid.Column="0" VerticalAlignment="Center"
                                    Margin="0,0,16,0" MaxWidth="220">
                            <TextBlock Text="{Binding TrackTitle}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding TrackSubtitle}" FontSize="12" Foreground="#DDFFFFFF"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="PlayerTransport" Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0">
                            <Button x:Name="PrevButton" Style="{StaticResource PlaybackIconButtonStyle}"
                                    Command="{Binding PreviousCommand}" AutomationProperties.Name="上一首">
                                <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                            </Button>
                            <Button x:Name="PlayButton" Style="{StaticResource PlaybackIconButtonStyle}" Width="48" Height="48"
                                    Margin="18,0,0,0" Command="{Binding TogglePlayPauseCommand}"
                                    AutomationProperties.Name="播放或暂停">
                                <Grid x:Name="PlayIconGrid" Width="40" Height="40">
                                    <Ellipse x:Name="PlayCircle" Stroke="White" StrokeThickness="1.5"/>
                                    <FontIcon Glyph="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets"
                                              FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0"
                                    Command="{Binding NextCommand}" AutomationProperties.Name="下一首">
                                <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="VolumePanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 播放顺序按钮移到右侧 -->
                            <Button x:Name="ModeButton" Width="96" Height="40" Padding="0" Margin="0,0,12,0"
                                    Style="{StaticResource PlayerModeButtonStyle}"
                                    Visibility="{Binding IsCurrentAudio, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding CyclePlayModeCommand}"
                                    AutomationProperties.Name="切换播放顺序">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Glyph="{Binding PlayModeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                              Foreground="White"/>
                                    <TextBlock x:Name="PlayerModeText" Text="{Binding PlayModeText}" FontSize="11" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                            <Slider RequestedTheme="Dark" Style="{StaticResource PlayerSliderStyle}" x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" Margin="12,0,0,0"
                                    Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"
                                    Foreground="{StaticResource SliderFillBrush}" Background="{StaticResource SliderTrackBrush}"/>
                            <Button x:Name="MoreButton" Style="{StaticResource PlaybackIconButtonStyle}" Margin="14,0,0,0"
                                    AutomationProperties.Name="更多">
                                <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                            </Button>
                            <Button x:Name="PlayerOverflowButton" Style="{StaticResource PlaybackIconButtonStyle}"
                                    Margin="8,0,0,0" Visibility="Collapsed" AutomationProperties.Name="播放选项">
                                <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutSubItem Text="播放顺序">
                                            <MenuFlyoutItem Text="顺序播放" Command="{Binding SetPlayModeCommand}" CommandParameter="Sequential"/>
                                            <MenuFlyoutItem Text="随机播放" Command="{Binding SetPlayModeCommand}" CommandParameter="Shuffle"/>
                                            <MenuFlyoutItem Text="列表循环" Command="{Binding SetPlayModeCommand}" CommandParameter="RepeatAll"/>
                                            <MenuFlyoutItem Text="单曲循环" Command="{Binding SetPlayModeCommand}" CommandParameter="RepeatOne"/>
                                            <MenuFlyoutItem Text="只播放本曲" Command="{Binding SetPlayModeCommand}" CommandParameter="PlayOnce"/>
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 下排：进度条占满整行 -->
                    <Grid x:Name="PlayerProgressRow" Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" FontSize="11"
                                   Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Slider RequestedTheme="Dark" Style="{StaticResource PlayerSliderStyle}" Grid.Column="1" Minimum="0" Maximum="{Binding PlaybackDuration}"
                                Value="{Binding PlaybackPosition, Mode=TwoWay}" VerticalAlignment="Center"
                                Foreground="{StaticResource SliderFillBrush}" Background="{StaticResource SliderTrackBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" FontSize="11"
                                   Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 汉堡菜单展开面板 ==================== -->
        <Rectangle x:Name="ClickAway" Grid.Row="1" Grid.ColumnSpan="2" Fill="#00000000"
                   Visibility="Collapsed" Tapped="ClickAway_Tapped"/>
        <Grid x:Name="MenuOverlay" Grid.Row="1" Grid.ColumnSpan="2" Width="260" HorizontalAlignment="Left"
              Visibility="Collapsed" Background="{StaticResource NavBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 汉堡按钮保持在收起时的同一位置 -->
            <StackPanel Grid.Row="0" Margin="0,8,0,0">
                <Button Width="40" Height="40" Margin="16,0,0,0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="Hamburger_Click" AutomationProperties.Name="收起菜单">
                    <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                </Button>
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Row="1" Height="36" Margin="12,6,12,16"
                     PlaceholderText="搜索媒体" TextChanged="SearchBox_TextChanged"
                     AutomationProperties.Name="搜索媒体"/>

            <ListView x:Name="MenuList" Grid.Row="2" ItemsSource="{Binding NavItems}"
                      ItemContainerStyle="{StaticResource NavItemStyle}"
                      SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="NavList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:NavItem">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Rectangle HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Width="3" Height="22" Fill="{StaticResource AccentBrush}"
                                           Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Glyph="{x:Bind Glyph, Mode=OneWay}"
                                          FontFamily="Segoe MDL2 Assets" FontSize="20"
                                          Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind Label, Mode=OneWay}" FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" FontSize="12"
                                       Margin="0,0,16,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="3" BorderBrush="#FFE4E4E4" BorderThickness="0,1,0,0" Padding="6,6">
                <Button Height="40" Padding="8,0" HorizontalAlignment="Stretch"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="Settings_Click" AutomationProperties.Name="设置">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="30"/>
                        <TextBlock Text="设置" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ==================== 正在播放（全屏浮层） ==================== -->
        <Grid x:Name="PlayerOverlay" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="{StaticResource NowPlayingBackdropBrush}"
              PointerMoved="PlayerOverlay_PointerMoved">
            <!-- 14393+ 时在代码中动态注入 MediaPlayerElement；10240 上该 XAML 类型不存在 -->
            <Grid x:Name="VideoHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Grid x:Name="AudioPanel" Visibility="Collapsed" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" Margin="16,72,16,150">

                <!-- 宽窗：封面与歌词成对居中靠拢 -->
                <Grid x:Name="WideLyricLayout">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="100" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="*" MaxWidth="100" MinWidth="0"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="NowPlayingArt" Grid.Column="1" VerticalAlignment="Center"
                                Margin="0,0,48,0" MaxWidth="320">
                        <Border x:Name="NowPlayingCover" Width="280" Height="280"
                                Background="{Binding TrackFallbackBrush}" HorizontalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding TrackInitial}" FontSize="84" Foreground="#59FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasTrackThumbnail, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                                <Image Source="{Binding TrackThumbnail}" Stretch="UniformToFill"
                                       Visibility="{Binding HasTrackThumbnail, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="NowPlayingTitle" Text="{Binding TrackTitle}" FontSize="20"
                                   FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,22,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowPlayingSubtitle" Text="{Binding TrackSubtitle}" FontSize="13"
                                   Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="2" MaxWidth="600" MinWidth="0"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ListView x:Name="WideLyricList" ItemsSource="{Binding Lyrics}"
                                  SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="LyricLine_ItemClick"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent" MaxHeight="440">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10" HorizontalAlignment="Center">
                                        <TextBlock x:Name="LyricText" Text="{Binding Text}"
                                                   FontSize="{Binding IsCurrent, Converter={StaticResource BoolToFontSizeConverter}, ConverterParameter=40|22}"
                                                   FontWeight="{Binding IsCurrent, Converter={StaticResource BoolToFontWeightConverter}}"
                                                   Foreground="{Binding IsCurrent, Converter={StaticResource BoolToLyricBrushConverter}}"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Visibility="{Binding Words, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <ItemsControl ItemsSource="{Binding Words}"
                                                      Visibility="{Binding Words, Converter={StaticResource NullToVisibilityConverter}}"
                                                      HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:WordWrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}"
                                                               FontSize="{Binding IsLineCurrent, Converter={StaticResource BoolToFontSizeConverter}, ConverterParameter=40|22}"
                                                               FontWeight="{Binding IsLineCurrent, Converter={StaticResource BoolToFontWeightConverter}}"
                                                               Foreground="{Binding IsSung, Converter={StaticResource BoolToLyricBrushConverter}}"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="暂无歌词" FontSize="14" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasLyrics, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Grid>

                <!-- 窄窗：小封面头部 + 完整歌词列表 -->
                <Grid x:Name="NarrowLyricLayout" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,0,0">
                        <Border Width="64" Height="64" Background="{Binding TrackFallbackBrush}">
                            <Grid>
                                <TextBlock Text="{Binding TrackInitial}" FontSize="26" Foreground="#59FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasTrackThumbnail, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                                <Image Source="{Binding TrackThumbnail}" Stretch="UniformToFill"
                                       Visibility="{Binding HasTrackThumbnail, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TrackTitle}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding TrackSubtitle}" FontSize="13" Foreground="#CCFFFFFF"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="16,8,16,0">
                        <ListView x:Name="NarrowLyricList" ItemsSource="{Binding Lyrics}"
                                  SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="LyricLine_ItemClick"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <TextBlock x:Name="LyricText" Text="{Binding Text}"
                                                   FontSize="{Binding IsCurrent, Converter={StaticResource BoolToFontSizeConverter}, ConverterParameter=28|18}"
                                                   FontWeight="{Binding IsCurrent, Converter={StaticResource BoolToFontWeightConverter}}"
                                                   Foreground="{Binding IsCurrent, Converter={StaticResource BoolToLyricBrushConverter}}"
                                                   TextAlignment="Left" TextWrapping="Wrap"
                                                   Visibility="{Binding Words, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <ItemsControl ItemsSource="{Binding Words}"
                                                      Visibility="{Binding Words, Converter={StaticResource NullToVisibilityConverter}}"
                                                      HorizontalAlignment="Left">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:WordWrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}"
                                                               FontSize="{Binding IsLineCurrent, Converter={StaticResource BoolToFontSizeConverter}, ConverterParameter=28|18}"
                                                               FontWeight="{Binding IsLineCurrent, Converter={StaticResource BoolToFontWeightConverter}}"
                                                               Foreground="{Binding IsSung, Converter={StaticResource BoolToLyricBrushConverter}}"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="暂无歌词" FontSize="14" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Visibility="{Binding HasLyrics, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 全部歌词面板：完整歌词列表，点击行可跳转播放位置 -->
            <Border x:Name="FullLyricPanel" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                    VerticalAlignment="Stretch" Width="360" Margin="0,64,0,0"
                    Background="#F21C1C1C" BorderBrush="#FF333333" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="14,10" Background="#FF252525">
                        <TextBlock Text="全部歌词" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource OverlayIconButtonStyle}" Width="32" Height="32"
                                HorizontalAlignment="Right" Click="CloseFullLyric_Click"
                                ToolTipService.ToolTip="关闭" AutomationProperties.Name="关闭全部歌词">
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"/>
                        </Button>
                    </Grid>
                    <ListView x:Name="FullLyricList" Grid.Row="1" ItemsSource="{Binding Lyrics}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="FullLyric_ItemClick" Padding="0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="FullLyricText" Text="{Binding Text}"
                                           FontSize="15" Foreground="#AAFFFFFF" TextWrapping="Wrap"
                                           Margin="14,7" IsHitTestVisible="False"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 自绘字幕层（外挂 SRT/VTT/ASS，10240 可用） -->
            <Border x:Name="SubtitleLayer" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,150" MaxWidth="900" Padding="16,8" IsHitTestVisible="False"
                    Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Name="SubtitleText" Text="{Binding CurrentSubtitleText}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="{Binding CurrentSubtitleFontSize}"
                           Foreground="{Binding CurrentSubtitleColorHex, Converter={StaticResource HexColorToBrushConverter}}"/>
            </Border>
            <Grid x:Name="VideoTopBar" Height="64" VerticalAlignment="Top" Padding="16,0" Background="#CC000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                        ToolTipService.ToolTip="返回 (Esc)"
                        Click="ClosePlayer_Click" AutomationProperties.Name="关闭播放界面">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"/>
                </Button>
                <!-- 顶部仅保留操作按钮，不再显示「正在播放」文字 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                            ToolTipService.ToolTip="添加到播放列表" Click="AddToPlaylist_Click"
                            AutomationProperties.Name="添加到播放列表">
                        <FontIcon Glyph="&#xE728;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                            ToolTipService.ToolTip="播放队列" Command="{Binding ToggleQueuePanelCommand}"
                            AutomationProperties.Name="播放队列">
                        <FontIcon Glyph="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                    </Button>
                    <!-- 歌词按钮只对音频有意义，视频播放页隐藏 -->
                    <Button Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                            ToolTipService.ToolTip="全部歌词（点击跳转）" Click="ToggleFullLyric_Click"
                            Visibility="{Binding IsCurrentVideo, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="全部歌词">
                        <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                            ToolTipService.ToolTip="音乐信息 / 编辑元数据" Click="Metadata_Click"
                            Visibility="{Binding IsCurrentVideo, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="音乐信息">
                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                            ToolTipService.ToolTip="选词（搜索并选择歌词）" Command="{Binding PickLyricsCommand}"
                            Visibility="{Binding IsCurrentVideo, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="选词">
                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                            ToolTipService.ToolTip="桌面歌词" Command="{Binding ToggleDesktopLyricsCommand}"
                            Visibility="{Binding IsCurrentVideo, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="桌面歌词">
                        <FontIcon Glyph="&#xE7F3;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                    </Button>
                    <!-- 字幕只对视频有意义，音频播放页不再显示外挂字幕按钮 -->
                    <Button Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                            ToolTipService.ToolTip="字幕（内嵌 / 外挂）" Click="Subtitle_Click"
                            Visibility="{Binding IsCurrentVideo, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="字幕">
                        <FontIcon Glyph="&#xE8BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButtonStyle}" Width="40" Height="36"
                            ToolTipService.ToolTip="画中画" Click="PictureInPicture_Click"
                            Visibility="{Binding IsCurrentVideo, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="画中画">
                        <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid x:Name="VideoBottomBar" VerticalAlignment="Bottom" Padding="24,16" Background="#99000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 播放控制行：左侧留白 / 中间传输按钮 / 右侧音量、倍速、全屏 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PlaybackIconButtonStyle}"
                                Command="{Binding PreviousCommand}" AutomationProperties.Name="上一首">
                            <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource PlaybackIconButtonStyle}" Width="48" Height="48" Margin="18,0,0,0"
                                Command="{Binding TogglePlayPauseCommand}" AutomationProperties.Name="播放或暂停">
                            <Grid Width="40" Height="40">
                                <Ellipse Stroke="White" StrokeThickness="1.5"/>
                                <FontIcon Glyph="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets"
                                          FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0"
                                Command="{Binding NextCommand}" AutomationProperties.Name="下一首">
                            <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="NowPlayingModeButton" Width="90" Height="34" Padding="0" Margin="0,0,12,0"
                                Style="{StaticResource PlayerModeButtonStyle}"
                                Visibility="{Binding IsPlayOrderVisible, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding CyclePlayModeCommand}" AutomationProperties.Name="切换播放顺序">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="{Binding PlayModeGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="White"/>
                                <TextBlock Text="{Binding PlayModeText}" FontSize="11" Margin="6,0,0,0"
                                           VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NowPlayingVolumeButton" Width="40" Height="34" Padding="0" Margin="0,0,8,0"
                                Style="{StaticResource PlaybackIconButtonStyle}"
                                ToolTipService.ToolTip="音量" AutomationProperties.Name="音量">
                            <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"/>
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="#FF1C1C1C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="RequestedTheme" Value="Dark"/>
                                            <Setter Property="BorderBrush" Value="#FF333333"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Width="200" Padding="12">
                                        <TextBlock Text="音量" FontSize="12" Foreground="#CCFFFFFF"/>
                                        <Slider RequestedTheme="Dark" Style="{StaticResource PlayerSliderStyle}" Minimum="0" Maximum="100" Margin="0,10,0,0"
                                                Value="{Binding Volume, Mode=TwoWay}"
                                                Foreground="{StaticResource OverlaySliderFillBrush}"
                                                Background="{StaticResource OverlaySliderTrackBrush}"
                                                AutomationProperties.Name="音量"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="NowPlayingRateButton" Width="52" Height="34" Padding="0" Margin="0,0,8,0"
                                Style="{StaticResource PlaybackIconButtonStyle}"
                                Command="{Binding CycleRateCommand}"
                                ToolTipService.ToolTip="播放倍速" AutomationProperties.Name="播放倍速">
                            <TextBlock Text="{Binding RateText}" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button x:Name="NowPlayingFullscreenButton" Width="40" Height="34" Padding="0"
                                Style="{StaticResource PlaybackIconButtonStyle}"
                                Click="Fullscreen_Click"
                                ToolTipService.ToolTip="全屏" AutomationProperties.Name="全屏">
                            <FontIcon Glyph="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                        </Button>
                        <Button x:Name="NowPlayingMoreButton" Width="40" Height="34" Padding="0"
                                Style="{StaticResource PlaybackIconButtonStyle}" Visibility="Collapsed"
                                ToolTipService.ToolTip="更多播放设置" AutomationProperties.Name="更多播放设置">
                            <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White"/>
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="#FF1C1C1C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="RequestedTheme" Value="Dark"/>
                                            <Setter Property="BorderBrush" Value="#FF333333"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Width="220" MaxWidth="260" Padding="8">
                                        <TextBlock Text="播放顺序" FontSize="12" Foreground="#CCFFFFFF"/>
                                        <controls:WordWrapPanel>
                                            <Button Content="顺序" Padding="8,4" Margin="0,0,6,6"
                                                    Command="{Binding SetPlayModeCommand}" CommandParameter="Sequential"/>
                                            <Button Content="随机" Padding="8,4" Margin="0,0,6,6"
                                                    Command="{Binding SetPlayModeCommand}" CommandParameter="Shuffle"/>
                                            <Button Content="列表循环" Padding="8,4" Margin="0,0,6,6"
                                                    Command="{Binding SetPlayModeCommand}" CommandParameter="RepeatAll"/>
                                            <Button Content="单曲循环" Padding="8,4" Margin="0,0,6,6"
                                                    Command="{Binding SetPlayModeCommand}" CommandParameter="RepeatOne"/>
                                            <Button Content="只播放本曲" Padding="8,4" Margin="0,0,6,6"
                                                    Command="{Binding SetPlayModeCommand}" CommandParameter="PlayOnce"/>
                                        </controls:WordWrapPanel>

                                        <TextBlock Text="播放速度" FontSize="12" Foreground="#CCFFFFFF" Margin="0,14,0,6"/>
                                        <Button Content="{Binding RateText}" Padding="12,4" Margin="0,0,0,6"
                                                Command="{Binding CycleRateCommand}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" FontSize="11" Foreground="White"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Slider RequestedTheme="Dark" Style="{StaticResource PlayerSliderStyle}" Grid.Column="1" Minimum="0" Maximum="{Binding PlaybackDuration}"
                            Value="{Binding PlaybackPosition, Mode=TwoWay}"
                            Foreground="{StaticResource OverlaySliderFillBrush}"
                            Background="{StaticResource OverlaySliderTrackBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" FontSize="11" Foreground="White"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- 点击面板外部收起队列 -->
            <Rectangle x:Name="QueueClickAway" Fill="#00000000"
                       Visibility="{Binding IsQueuePanelOpen, Converter={StaticResource BoolToVisibility}}"
                       PointerPressed="QueueClickAway_PointerPressed"/>

            <!-- 播放队列面板：播放时查看与管理队列 -->
            <Grid x:Name="QueuePanel" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Width="340" Margin="0,64,0,118" RequestedTheme="Dark"
                  Background="#FF1E1E1E" BorderBrush="#33FFFFFF" BorderThickness="1"
                  Visibility="{Binding IsQueuePanelOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12,0" Background="#99000000">
                    <TextBlock Text="播放队列" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Queue.Count}" FontSize="12" Foreground="#AAFFFFFF"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,46,0"/>
                    <Button Width="34" Height="32" Padding="0" HorizontalAlignment="Right"
                            Style="{StaticResource OverlayIconButtonStyle}"
                            Command="{Binding ToggleQueuePanelCommand}" AutomationProperties.Name="关闭队列">
                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                </Grid>
                <ListView Grid.Row="1" x:Name="QueueList" ItemsSource="{Binding Queue}"
                          SelectionMode="None" Padding="4" Background="Transparent"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,7" MinHeight="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 当前播放项高亮 -->
                                <Border Grid.ColumnSpan="2" Background="#2BFFFFFF" IsHitTestVisible="False"
                                        Visibility="{Binding IsCurrentQueueItem, Converter={StaticResource BoolToVisibility}}"/>
                                <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsCurrentQueueItem, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel Grid.Column="0" Margin="11,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#AAFFFFFF"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button Width="28" Height="28" Padding="0" Margin="1,0"
                                            Background="Transparent"
                                            Style="{StaticResource OverlayIconButtonStyle}"
                                            Click="QueuePlay_Click" ToolTipService.ToolTip="播放"
                                            AutomationProperties.Name="播放此曲">
                                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                    <Button Width="28" Height="28" Padding="0" Margin="1,0"
                                            Background="Transparent"
                                            Style="{StaticResource OverlayIconButtonStyle}"
                                            Click="QueueUp_Click" ToolTipService.ToolTip="上移"
                                            AutomationProperties.Name="上移">
                                        <FontIcon Glyph="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                    <Button Width="28" Height="28" Padding="0" Margin="1,0"
                                            Background="Transparent"
                                            Style="{StaticResource OverlayIconButtonStyle}"
                                            Click="QueueDown_Click" ToolTipService.ToolTip="下移"
                                            AutomationProperties.Name="下移">
                                        <FontIcon Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                    <Button Width="28" Height="28" Padding="0" Margin="1,0"
                                            Background="Transparent"
                                            Style="{StaticResource OverlayIconButtonStyle}"
                                            Click="QueueRemove_Click" ToolTipService.ToolTip="移除"
                                            AutomationProperties.Name="移除">
                                        <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Padding="10" Background="#99000000">
                    <Button Content="清空队列" HorizontalAlignment="Stretch" Height="34"
                            Command="{Binding ClearQueueCommand}" Background="Transparent"
                            Foreground="White" BorderThickness="1"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 图片灯箱（参考 HyperViewer） ==================== -->
        <Grid x:Name="PhotoOverlay" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#FF000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0" x:Name="InfoColumn"/>
            </Grid.ColumnDefinitions>

            <!-- 主图区 -->
            <Grid Grid.Column="0">
                <controls:ImageViewer x:Name="PhotoViewer" Margin="0,56,0,92"
                                      ZoomFactorChanged="PhotoViewer_ZoomFactorChanged"
                                      DoubleTappedOccurred="PhotoViewer_DoubleTappedOccurred"/>

                <ProgressRing x:Name="PhotoLoadingRing" Width="44" Height="44"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsActive="False" Visibility="Collapsed" Foreground="White"/>

                <StackPanel x:Name="PhotoFailedPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                              Foreground="#FFFF8080" HorizontalAlignment="Center"/>
                    <TextBlock Text="无法打开此图片" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <Button Content="重试" HorizontalAlignment="Center" Margin="0,14,0,0"
                            Padding="20,6" Background="#33FFFFFF" Foreground="White"
                            BorderThickness="0" Click="PhotoRetry_Click"/>
                </StackPanel>

                <Button x:Name="PhotoPrevArrow" Width="44" Height="44" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                        Style="{StaticResource OverlayIconButtonStyle}"
                        ToolTipService.ToolTip="上一张 (←)"
                        Click="PhotoPrevious_Click" AutomationProperties.Name="上一张">
                    <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                </Button>
                <Button x:Name="PhotoNextArrow" Width="44" Height="44" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                        Style="{StaticResource OverlayIconButtonStyle}"
                        ToolTipService.ToolTip="下一张 (→)"
                        Click="PhotoNext_Click" AutomationProperties.Name="下一张">
                    <FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                </Button>

                <Border x:Name="SlideProgressHost" Height="3" VerticalAlignment="Bottom"
                        Background="#33FFFFFF" Visibility="Collapsed">
                    <ProgressBar x:Name="SlideProgress" Minimum="0" Maximum="1" Height="3"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>

            <!-- 信息侧栏 -->
            <Border x:Name="InfoPanel" Grid.Column="1" Visibility="Collapsed"
                    Margin="0,56,0,92"
                    Background="#FF1C1C1C" BorderBrush="#FF333333" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="14,10" Background="#FF252525">
                        <TextBlock Text="图片信息" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <ListView x:Name="InfoList" Grid.Row="1" SelectionMode="None"
                              IsItemClickEnabled="False" Padding="0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:InfoRow">
                                <Grid Padding="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Key, Mode=OneWay}"
                                               FontSize="12" Foreground="#FF9A9A9A"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}"
                                               FontSize="12" Foreground="White" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 顶部工具栏 -->
            <Grid Grid.ColumnSpan="2" Height="56" VerticalAlignment="Top" Padding="12,0"
                  Background="#FF000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="40" Height="34" Padding="0"
                        Style="{StaticResource OverlayIconButtonStyle}"
                        ToolTipService.ToolTip="返回 (Esc)"
                        Click="ClosePhoto_Click" AutomationProperties.Name="关闭图片">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"/>
                </Button>
                <TextBlock x:Name="PhotoTitle" Grid.Column="1" FontSize="13" Foreground="#CCFFFFFF"
                           MaxWidth="260" Margin="12,0,8,0" VerticalAlignment="Center"
                           HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider RequestedTheme="Dark" Style="{StaticResource PlayerSliderStyle}" x:Name="ZoomSlider" Width="120" Minimum="10" Maximum="1000" StepFrequency="1"
                            Value="100" VerticalAlignment="Center" Margin="0,0,8,0"
                            ValueChanged="ZoomSlider_ValueChanged"
                            Foreground="{StaticResource OverlaySliderFillBrush}"
                            Background="{StaticResource OverlaySliderTrackBrush}"
                            AutomationProperties.Name="缩放"/>
                    <Button x:Name="PhotoFitButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="适应窗口 (0)"
                            Click="Fit_Click" AutomationProperties.Name="适应窗口">
                        <FontIcon Glyph="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="PhotoPrintButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="打印当前图片" Click="PrintPhoto_Click"
                            AutomationProperties.Name="打印当前图片">
                        <FontIcon Glyph="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="PhotoTileButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="把这些图片设为磁贴轮播" Click="PhotoTile_Click"
                            AutomationProperties.Name="磁贴轮播">
                        <FontIcon Glyph="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="PhotoRotateBackButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="逆时针旋转"
                            Click="RotateBack_Click" AutomationProperties.Name="逆时针旋转">
                        <FontIcon Glyph="&#xE80D;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="PhotoRotateButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="顺时针旋转 (R)"
                            Click="Rotate_Click" AutomationProperties.Name="顺时针旋转">
                        <FontIcon Glyph="&#xE80C;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="FlipHButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="水平翻转"
                            Click="FlipH_Click" AutomationProperties.Name="水平翻转">
                        <TextBlock Text="↔" FontSize="16" Foreground="White"/>
                    </Button>
                    <Button x:Name="FlipVButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="垂直翻转"
                            Click="FlipV_Click" AutomationProperties.Name="垂直翻转">
                        <TextBlock Text="↕" FontSize="16" Foreground="White"/>
                    </Button>
                    <Button x:Name="PhotoInfoButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="图片信息 (I)"
                            Click="Info_Click" AutomationProperties.Name="图片信息">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="PhotoEditButton" Style="{StaticResource OverlayIconButtonStyle}" Margin="0,0,4,0"
                            ToolTipService.ToolTip="编辑图片"
                            Click="Edit_Click" AutomationProperties.Name="编辑图片">
                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="PhotoSlideButton" Style="{StaticResource OverlayIconButtonStyle}"
                            ToolTipService.ToolTip="幻灯片 (空格)"
                            Click="SlideShow_Click" AutomationProperties.Name="幻灯片">
                        <FontIcon Glyph="&#xE786;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>
                    <Button x:Name="PhotoOverflowButton" Style="{StaticResource OverlayIconButtonStyle}"
                            Margin="4,0,0,0" Visibility="Collapsed" AutomationProperties.Name="更多图片操作">
                        <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="水平翻转" Click="FlipH_Click"/>
                                <MenuFlyoutItem Text="垂直翻转" Click="FlipV_Click"/>
                                <MenuFlyoutItem Text="逆时针旋转" Click="RotateBack_Click"/>
                                <MenuFlyoutItem Text="顺时针旋转" Click="Rotate_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="适应窗口" Click="Fit_Click"/>
                                <MenuFlyoutItem Text="图片信息" Click="Info_Click"/>
                                <MenuFlyoutItem Text="编辑图片" Click="Edit_Click"/>
                                <MenuFlyoutItem Text="幻灯片" Click="SlideShow_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 底部胶片条 -->
            <Grid Grid.ColumnSpan="2" Height="92" VerticalAlignment="Bottom" Background="#FF000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource OverlayIconButtonStyle}" Margin="8,0"
                        ToolTipService.ToolTip="上一张 (←)"
                        Click="PhotoPrevious_Click" AutomationProperties.Name="上一张">
                    <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <ListView x:Name="Filmstrip" Grid.Column="1" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="Filmstrip_ItemClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <Border Width="72" Height="56" Margin="3,0" Background="#FF333333"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                                <Grid>
                                    <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="22"
                                               Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind HasThumbnail, Mode=OneWay, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                           Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="PhotoCounter" FontSize="12" Foreground="#CCFFFFFF"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource OverlayIconButtonStyle}"
                            ToolTipService.ToolTip="下一张 (→)"
                            Click="PhotoNext_Click" AutomationProperties.Name="下一张">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 歌词选择面板：覆盖在「正在播放」之上，关闭后回到正在播放 -->
        <Grid x:Name="LyricPickerOverlay" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="#FF1E1E1E">
            <Frame x:Name="LyricPickerFrame"/>
        </Grid>
    </Grid>
</Page>
