<Page
    x:Class="HyperMedia_Lite.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HyperMedia_Lite.Models"
    xmlns:helpers="using:HyperMedia_Lite.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:BoolToAccentBrushConverter x:Key="BoolToAccentBrush"/>
        <helpers:BoolToTextBrushConverter x:Key="BoolToTextBrush"/>
        <helpers:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <helpers:TextToVisibilityConverter x:Key="TextToVisibility"/>

        <Style x:Key="NavItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="CardItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SongItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="PlaybackIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧窄导航栏（Groove 风格） ==================== -->
        <Grid Grid.Column="0" Background="{StaticResource NavBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,8,0,0">
                <Button Width="48" Height="48" Margin="22,0,0,0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="Back_Click" AutomationProperties.Name="返回">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                </Button>
                <Button x:Name="HamburgerButton" Width="48" Height="48" Margin="22,8,0,0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="Hamburger_Click" AutomationProperties.Name="菜单">
                    <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                </Button>
                <Button Width="48" Height="48" Margin="22,8,0,0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="Search_Click" AutomationProperties.Name="搜索">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                </Button>
            </StackPanel>

            <ListView x:Name="RailList" Grid.Row="1" Margin="0,14,0,0"
                      ItemsSource="{Binding NavItems}"
                      ItemContainerStyle="{StaticResource NavItemStyle}"
                      SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="NavList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:NavItem">
                        <Grid Width="92" Height="52">
                            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Width="3" Height="26" Fill="{StaticResource AccentBrush}"
                                       Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Glyph="{x:Bind Glyph, Mode=OneWay}"
                                      FontFamily="Segoe MDL2 Assets" FontSize="20"
                                      Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2" Width="48" Height="48" Margin="22,0,0,16" Padding="0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource NavForegroundBrush}"
                    Click="Settings_Click" AutomationProperties.Name="设置">
                <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
            </Button>
        </Grid>

        <!-- ==================== 内容区 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：标题 / 选项卡 / 工具条 -->
            <StackPanel Grid.Row="0" Padding="32,24,32,0" Background="{StaticResource SurfaceBrush}">
                <TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding ShowMusicTabs, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabSongs" Tag="0" Padding="0" BorderThickness="0"
                                Background="Transparent" Click="Tab_Click"
                                Foreground="{Binding IsSongsVisible, Converter={StaticResource BoolToTextBrush}}"
                                AutomationProperties.Name="歌曲">
                            <StackPanel>
                                <TextBlock Text="歌曲" FontSize="16"/>
                                <Rectangle Height="2" Margin="0,6,0,0" Fill="{StaticResource AccentBrush}"
                                           Visibility="{Binding IsSongsVisible, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabArtists" Tag="1" Margin="28,0,0,0" Padding="0" BorderThickness="0"
                                Background="Transparent" Click="Tab_Click"
                                Foreground="{Binding IsArtistsVisible, Converter={StaticResource BoolToTextBrush}}"
                                AutomationProperties.Name="歌手">
                            <StackPanel>
                                <TextBlock Text="歌手" FontSize="16"/>
                                <Rectangle Height="2" Margin="0,6,0,0" Fill="{StaticResource AccentBrush}"
                                           Visibility="{Binding IsArtistsVisible, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabAlbums" Tag="2" Margin="28,0,0,0" Padding="0" BorderThickness="0"
                                Background="Transparent" Click="Tab_Click"
                                Foreground="{Binding IsAlbumsVisible, Converter={StaticResource BoolToTextBrush}}"
                                AutomationProperties.Name="专辑">
                            <StackPanel>
                                <TextBlock Text="专辑" FontSize="16"/>
                                <Rectangle Height="2" Margin="0,6,0,0" Fill="{StaticResource AccentBrush}"
                                           Visibility="{Binding IsAlbumsVisible, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="20,-4,0,0" Padding="6,2" BorderThickness="0"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                Command="{Binding ClearArtistFilterCommand}"
                                Visibility="{Binding HasArtistFilter, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="清除歌手筛选">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ArtistFilter}" FontSize="12"/>
                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Rectangle Height="1" Fill="#FFE4E4E4" Margin="0,10,0,0"
                           Visibility="{Binding ShowMusicTabs, Converter={StaticResource BoolToVisibility}}"/>

                <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Command="{Binding ShuffleAllCommand}"
                                AutomationProperties.Name="无序播放所有">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                <TextBlock Text="{Binding PlayAllText}" Margin="8,0,0,0" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="24,0,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                AutomationProperties.Name="排序依据">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="排序依据:"/>
                                <TextBlock Text="{Binding SortDescription}" Margin="6,0,0,0"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <FontIcon Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                                  Height="30" MinWidth="100" Margin="0,0,8,0"
                                  AutomationProperties.Name="排序方式"/>
                        <Button Width="32" Height="30" Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Command="{Binding RefreshCommand}" AutomationProperties.Name="刷新媒体库">
                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Width="32" Height="30" Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Command="{Binding AddFilesCommand}" AutomationProperties.Name="添加媒体">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 主体：专辑 / 歌曲 / 歌手 / 通用视图 -->
            <Grid Grid.Row="1" Background="{StaticResource SurfaceBrush}">

                <!-- 专辑 -->
                <GridView x:Name="AlbumGrid" Padding="28,8,28,20"
                          ItemsSource="{Binding Albums}" ItemContainerStyle="{StaticResource CardItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AlbumGrid_ItemClick"
                          Visibility="{Binding IsAlbumsVisible, Converter={StaticResource BoolToVisibility}}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlbumCard">
                            <Grid Width="200" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{x:Bind FallbackBrush, Mode=OneWay}">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="72"
                                                   Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasThumbnail, Mode=OneWay, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                               Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Height="38"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 歌曲 -->
                <ListView x:Name="SongList" Padding="28,8,28,20"
                          ItemsSource="{Binding Songs}" ItemContainerStyle="{StaticResource SongItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="SongList_ItemClick"
                          Visibility="{Binding IsSongsVisible, Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <Grid Height="56" Padding="8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{x:Bind KindGlyph, Mode=OneWay}"
                                          FontFamily="Segoe MDL2 Assets" FontSize="16"
                                          Foreground="{StaticResource NavForegroundBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind DurationText, Mode=OneWay}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 歌手 -->
                <GridView x:Name="ArtistGrid" Padding="28,8,28,20"
                          ItemsSource="{Binding Artists}" ItemContainerStyle="{StaticResource CardItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ArtistGrid_ItemClick"
                          Visibility="{Binding IsArtistsVisible, Converter={StaticResource BoolToVisibility}}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:ArtistCard">
                            <Grid Width="180" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{x:Bind FallbackBrush, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="72"
                                               Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind SongCountText, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 视频 / 图片 / 收藏 / 队列 / 最近 -->
                <GridView x:Name="GenericGrid" Padding="28,8,28,20"
                          ItemsSource="{Binding CurrentItems}" ItemContainerStyle="{StaticResource CardItemStyle}"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="MediaGrid_ItemClick"
                          Visibility="{Binding IsGenericVisible, Converter={StaticResource BoolToVisibility}}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <Grid Width="180" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{x:Bind FallbackBrush, Mode=OneWay}">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="64"
                                                   Foreground="#59FFFFFF" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind HasThumbnail, Mode=OneWay, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                               Visibility="{x:Bind HasThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Width="30" Height="30" Padding="0" Margin="0,4,4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="#99000000" BorderThickness="0"
                                                Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"
                                                Click="Favorite_Click" AutomationProperties.Name="收藏">
                                            <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                        </Button>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="#CC000000" Padding="6,2" Margin="0,0,4,4"
                                                Visibility="{x:Bind DurationText, Mode=OneWay, Converter={StaticResource TextToVisibility}}">
                                            <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 统计 -->
                <Grid Visibility="{Binding IsStatsVisible, Converter={StaticResource BoolToVisibility}}"
                      Background="{StaticResource SurfaceBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                  Foreground="{StaticResource NavForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="媒体统计" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding StatsText}" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 空状态 -->
                <Grid Background="{StaticResource SurfaceBrush}"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                  Foreground="{StaticResource NavForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="这里还没有媒体" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,20"/>
                        <Button Content="添加媒体" HorizontalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                BorderThickness="0" Padding="20,6" Command="{Binding AddFilesCommand}"/>
                    </StackPanel>
                </Grid>

                <ProgressBar VerticalAlignment="Top" Height="3" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <!-- ==================== 底部播放条 ==================== -->
            <Grid Grid.Row="2" Height="96" Padding="16,8" Background="{StaticResource AccentBrush}"
                  Visibility="{Binding IsPlayerVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="320">
                    <Border Width="80" Height="80" Background="{Binding TrackFallbackBrush}">
                        <Grid>
                            <TextBlock Text="{Binding TrackInitial}" FontSize="32" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasTrackThumbnail, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Source="{Binding TrackThumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding HasTrackThumbnail, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="210">
                        <TextBlock Text="{Binding TrackTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TrackSubtitle}" FontSize="12" Foreground="#DDFFFFFF"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="24,0" MaxWidth="600">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PlaybackIconButtonStyle}"
                                Command="{Binding ToggleShuffleCommand}"
                                Opacity="{Binding IsShuffle, Converter={StaticResource BoolToOpacityConverter}}"
                                AutomationProperties.Name="随机播放">
                            <FontIcon Glyph="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                        </Button>
                        <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0"
                                Command="{Binding PreviousCommand}" AutomationProperties.Name="上一首">
                            <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource PlaybackIconButtonStyle}" Width="48" Height="48"
                                Margin="18,0,0,0" Command="{Binding TogglePlayPauseCommand}"
                                AutomationProperties.Name="播放或暂停">
                            <Grid Width="40" Height="40">
                                <Ellipse Stroke="White" StrokeThickness="1.5"/>
                                <FontIcon Glyph="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets"
                                          FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0"
                                Command="{Binding NextCommand}" AutomationProperties.Name="下一首">
                            <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                        </Button>
                        <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0"
                                Command="{Binding ToggleRepeatCommand}"
                                Opacity="{Binding IsRepeat, Converter={StaticResource BoolToOpacityConverter}}"
                                AutomationProperties.Name="循环播放">
                            <FontIcon Glyph="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" FontSize="11"
                                   Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding PlaybackDuration}"
                                Value="{Binding PlaybackPosition, Mode=TwoWay}" VerticalAlignment="Center"
                                Foreground="White" Background="#66FFFFFF"/>
                        <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" FontSize="11"
                                   Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"/>
                    <Slider Width="120" Minimum="0" Maximum="100" Margin="12,0,0,0"
                            Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"
                            Foreground="White" Background="#66FFFFFF"/>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Width="32" Margin="14,0,0,0"
                            AutomationProperties.Name="歌词">
                        <TextBlock Text="词" FontSize="14" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="14,0,0,0"
                            AutomationProperties.Name="更多">
                        <FontIcon Glyph="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== 汉堡菜单展开面板 ==================== -->
        <Rectangle x:Name="ClickAway" Grid.ColumnSpan="2" Fill="#00000000"
                   Visibility="Collapsed" Tapped="ClickAway_Tapped"/>
        <Grid x:Name="MenuOverlay" Grid.ColumnSpan="2" Width="280" HorizontalAlignment="Left"
              Visibility="Collapsed" Background="{StaticResource NavBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="80" Padding="16,20,12,8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HyperMedia" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="本地媒体中心" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Width="32" Height="32" Padding="0" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="ClosePane_Click" AutomationProperties.Name="关闭菜单">
                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </Grid>
            <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="搜索媒体"
                     Margin="12,0,12,8" TextChanged="SearchBox_TextChanged"
                     AutomationProperties.Name="搜索媒体"/>
            <ListView x:Name="MenuList" Grid.Row="2" ItemsSource="{Binding NavItems}"
                      ItemContainerStyle="{StaticResource NavItemStyle}"
                      SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="NavList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:NavItem">
                        <Grid Height="52" Padding="8,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Width="3" Height="26" VerticalAlignment="Center"
                                       Fill="{StaticResource AccentBrush}"
                                       Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph, Mode=OneWay}"
                                      FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"
                                      Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Label, Mode=OneWay}" FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToAccentBrush}}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind CountText, Mode=OneWay}" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="3" BorderBrush="#FFE4E4E4" BorderThickness="0,1,0,0" Padding="8,8">
                <Button Height="44" Padding="8,0" HorizontalAlignment="Stretch"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource NavForegroundBrush}"
                        Click="Settings_Click" AutomationProperties.Name="设置">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="30"/>
                        <TextBlock Text="设置" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ==================== 正在播放（全屏浮层） ==================== -->
        <Grid x:Name="PlayerOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#FF0D0D0D">
            <MediaPlayerElement x:Name="VideoSurface" AreTransportControlsEnabled="False"
                                Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Grid x:Name="AudioPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="280" Height="280" Background="{Binding TrackFallbackBrush}"
                            HorizontalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding TrackInitial}" FontSize="96" Foreground="#59FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasTrackThumbnail, ConverterParameter=Invert, Converter={StaticResource BoolToVisibility}}"/>
                            <Image Source="{Binding TrackThumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding HasTrackThumbnail, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding TrackTitle}" FontSize="22" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,24,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TrackSubtitle}" FontSize="14" Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Height="64" VerticalAlignment="Top" Padding="16,0">
                <Button Content="返回" Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="ClosePlayer_Click" HorizontalAlignment="Left" AutomationProperties.Name="关闭播放界面"/>
                <TextBlock Text="正在播放" FontSize="14" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid VerticalAlignment="Bottom" Padding="24,16" Background="#99000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Command="{Binding ToggleShuffleCommand}"
                            AutomationProperties.Name="随机播放">
                        <FontIcon Glyph="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0"
                            Command="{Binding PreviousCommand}" AutomationProperties.Name="上一首">
                        <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                    </Button>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Width="48" Height="48" Margin="18,0,0,0"
                            Command="{Binding TogglePlayPauseCommand}" AutomationProperties.Name="播放或暂停">
                        <Grid Width="40" Height="40">
                            <Ellipse Stroke="White" StrokeThickness="1.5"/>
                            <FontIcon Glyph="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets"
                                      FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0"
                            Command="{Binding NextCommand}" AutomationProperties.Name="下一首">
                        <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="20"/>
                    </Button>
                    <Button Style="{StaticResource PlaybackIconButtonStyle}" Margin="18,0,0,0"
                            Command="{Binding ToggleRepeatCommand}" AutomationProperties.Name="循环播放">
                        <FontIcon Glyph="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentTimeText}" FontSize="11" Foreground="White"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding PlaybackDuration}"
                            Value="{Binding PlaybackPosition, Mode=TwoWay}" Foreground="White" Background="#66FFFFFF"/>
                    <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" FontSize="11" Foreground="White"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 图片灯箱 ==================== -->
        <Grid x:Name="PhotoOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#FF000000">
            <Image x:Name="PhotoImage" Stretch="Uniform" Margin="48,72"/>
            <Grid Height="64" VerticalAlignment="Top" Padding="16,0">
                <Button Content="返回" Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="ClosePhoto_Click" HorizontalAlignment="Left" AutomationProperties.Name="关闭图片"/>
                <TextBlock x:Name="PhotoTitle" FontSize="14" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
                <Button Content="上一张" Margin="0,0,12,0" Background="#33FFFFFF" Foreground="White"
                        BorderThickness="0" Click="PhotoPrevious_Click"/>
                <Button Content="下一张" Background="#33FFFFFF" Foreground="White"
                        BorderThickness="0" Click="PhotoNext_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
