<UserControl
    x:Class="HyperMedia_Lite.Controls.ImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid>
        <ScrollViewer x:Name="Scroller"
                      ZoomMode="Enabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden"
                      MinZoomFactor="0.1"
                      MaxZoomFactor="10"
                      IsHorizontalScrollChainingEnabled="True"
                      IsVerticalScrollChainingEnabled="True"
                      ManipulationMode="All"
                      ViewChanged="Scroller_ViewChanged"
                      DoubleTapped="Scroller_DoubleTapped"
                       
                      
                      Background="Transparent">
            <Image x:Name="TheImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   ImageOpened="TheImage_ImageOpened"
                   SizeChanged="TheImage_SizeChanged"
                   RenderTransformOrigin="0.5,0.5"/>
        </ScrollViewer>

        <!-- 适应窗口时的透明触摸板：在 ScrollViewer 之前拦截触摸，避免手势被系统吞掉。
             放大后自动隐藏，捏合/平移仍交给 ScrollViewer。 -->
        <Grid x:Name="TouchOverlay" Background="Transparent" Visibility="Collapsed"
              ManipulationMode="TranslateX,Scale"
              ManipulationStarting="TouchOverlay_ManipulationStarting"
              ManipulationStarted="TouchOverlay_ManipulationStarted"
              ManipulationDelta="TouchOverlay_ManipulationDelta"
              ManipulationCompleted="TouchOverlay_ManipulationCompleted"
              DoubleTapped="TouchOverlay_DoubleTapped"
              PointerWheelChanged="TouchOverlay_PointerWheelChanged"/>

        <ProgressRing x:Name="LoadingRing"
                      Width="44" Height="44"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsActive="False" Visibility="Collapsed"
                      IsHitTestVisible="False" Foreground="White"/>

        <Border x:Name="ZoomBadge"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,16" Background="#CC000000"
                Padding="12,5" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ZoomText" FontSize="12" Foreground="White"/>
        </Border>
    </Grid>
</UserControl>
