<Page
    x:Class="HyperMedia_Lite.MetadataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 与主页一致的自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32"
              Padding="16,0,140,0" Background="{StaticResource SurfaceBrush}">
            <TextBlock x:Name="AppTitleText" Text="HyperMedia" FontSize="12"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- 页头 -->
        <Grid Grid.Row="1" Padding="20,0" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="40" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Click="Back_Click" ToolTipService.ToolTip="返回" AutomationProperties.Name="返回">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                </Button>
                <TextBlock Text="音乐信息" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" Padding="24,16">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="96" Height="96" Background="{StaticResource SurfaceBrush}">
                        <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FileLabel" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                        <TextBlock x:Name="PathLabel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440" Margin="0,4,0,0"/>
                        <TextBlock x:Name="InfoLabel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="StatsLabel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="评分" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="Star1" Content="☆" FontSize="20" Padding="2,0" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" Click="Star_Click" Tag="1"/>
                            <Button x:Name="Star2" Content="☆" FontSize="20" Padding="2,0" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" Click="Star_Click" Tag="2"/>
                            <Button x:Name="Star3" Content="☆" FontSize="20" Padding="2,0" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" Click="Star_Click" Tag="3"/>
                            <Button x:Name="Star4" Content="☆" FontSize="20" Padding="2,0" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" Click="Star_Click" Tag="4"/>
                            <Button x:Name="Star5" Content="☆" FontSize="20" Padding="2,0" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" Click="Star_Click" Tag="5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="更换封面…" Padding="12,5" FontSize="12"
                                    Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderThickness="1" Click="ChangeCover_Click"/>
                            <Button Content="恢复" Padding="12,5" FontSize="12" Margin="8,0,0,0"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="1" Click="ResetCover_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="可编辑信息" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="标题" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Grid.Row="1" Text="艺人" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="ArtistBox" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Grid.Row="2" Text="专辑" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="AlbumBox" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Grid.Row="3" Text="专辑艺人" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="AlbumArtistBox" Grid.Row="3" Grid.Column="1"/>

                    <TextBlock Grid.Row="4" Text="副标题" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="SubtitleBox" Grid.Row="4" Grid.Column="1"/>

                    <TextBlock Grid.Row="5" Text="曲目号" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="TrackBox" Grid.Row="5" Grid.Column="1"/>

                    <TextBlock Grid.Row="6" Text="年份" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="YearBox" Grid.Row="6" Grid.Column="1"/>

                    <TextBlock Grid.Row="7" Text="评分 (0-100)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="RatingBox" Grid.Row="7" Grid.Column="1"/>

                    <TextBlock Grid.Row="8" Text="流派 / 作曲" Style="{StaticResource FieldLabelStyle}"/>
                    <StackPanel Grid.Row="8" Grid.Column="1">
                        <TextBox x:Name="GenreBox" PlaceholderText="流派，多个用逗号分隔"/>
                        <TextBox x:Name="ComposerBox" PlaceholderText="作曲，多个用逗号分隔" Margin="0,8,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="9" Text="出版者" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="PublisherBox" Grid.Row="9" Grid.Column="1"/>

                    <TextBlock Grid.Row="10" Text="指挥" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="ConductorBox" Grid.Row="10" Grid.Column="1"
                             PlaceholderText="多个用逗号分隔"/>

                    <TextBlock Grid.Row="11" Text="制作人" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="ProducerBox" Grid.Row="11" Grid.Column="1"
                             PlaceholderText="多个用逗号分隔"/>
                </Grid>

                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,14,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="部分文件格式不支持写入，保存失败时会在这里提示。"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="20,12" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="90" Height="36" Margin="0,0,10,0"
                        Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="1" Click="Back_Click"/>
                <Button x:Name="SaveButton" Content="保存" Width="110" Height="36"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
