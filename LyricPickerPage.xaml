<Page
    x:Class="HyperMedia_Lite.LyricPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource NowPlayingBackdropBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Padding="20,0" Background="#99000000">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="40" Height="36" Padding="0" Style="{StaticResource EditorIconButtonStyle}"
                        Click="Cancel_Click" ToolTipService.ToolTip="取消" AutomationProperties.Name="取消">
                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <TextBlock Text="选择歌词" FontSize="18" FontWeight="SemiBold"
                           Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#AAFFFFFF"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap"/>
        </Grid>

        <!-- 搜索区：Auto 高度，固定贴在标题栏下方 -->
        <Border Grid.Row="1" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                Margin="20,10,20,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="歌名" FontSize="12" Foreground="#AAFFFFFF"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TitleBox" Grid.Column="1" PlaceholderText="输入歌名"
                         RequestedTheme="Dark" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="艺人" FontSize="12" Foreground="#AAFFFFFF"
                           VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="ArtistBox" Grid.Column="3" PlaceholderText="输入艺人（可选）"
                         RequestedTheme="Dark" VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceCombo" Grid.Column="4" Width="110" Margin="12,0,8,0"
                          SelectedIndex="0" RequestedTheme="Dark" VerticalAlignment="Center"
                          AutomationProperties.Name="歌词来源">
                    <ComboBoxItem Content="全部来源" Tag="auto"/>
                    <ComboBoxItem Content="网易云" Tag="netease"/>
                    <ComboBoxItem Content="QQ 音乐" Tag="qq"/>
                </ComboBox>
                <Button x:Name="SearchButton" Grid.Column="5" Content="搜索" Width="80"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Click="Search_Click"/>
            </Grid>
        </Border>

        <!-- 候选列表 + 预览 -->
        <Grid Grid.Row="2" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                <ListView x:Name="CandidateList" SelectionMode="Single"
                          SelectionChanged="CandidateList_SelectionChanged"
                          Padding="4" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Background="{StaticResource AccentBrush}"
                                            Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source}" FontSize="10" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" Margin="6,0,0,0" MaxWidth="220"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Artist}" FontSize="11"
                                           Foreground="#AAFFFFFF" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Album}" FontSize="10" Foreground="#88FFFFFF"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                    <TextBlock Text="{Binding Format}" FontSize="10" Foreground="#88FFFFFF"
                                               Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding MatchLabel}" FontSize="10"
                                               Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Margin="10,0,0,0" Padding="12">
                <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PreviewPanel">
                        <TextBlock Text="歌词预览（完整）" FontSize="13" Foreground="#AAFFFFFF" Margin="0,0,0,8"/>
                        <TextBlock x:Name="PreviewText" FontSize="15" Foreground="White"
                                   TextWrapping="Wrap" LineHeight="23"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="20,0,20,14">
            <Button Content="使用本地歌词…" Width="120" Height="34" Margin="0,0,10,0"
                    Background="Transparent" Foreground="White" BorderThickness="1"
                    Click="UseLocal_Click" ToolTipService.ToolTip="从本地 LRC / KRC / QRC / TXT 文件载入"
                    AutomationProperties.Name="使用本地歌词"/>
            <Button Content="取消" Width="90" Height="34" Margin="0,0,10,0"
                    Background="Transparent" Foreground="White" BorderThickness="1"
                    Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="使用此歌词" Width="130" Height="34"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    IsEnabled="False" Click="Confirm_Click"/>
        </StackPanel>

        <ProgressBar x:Name="LoadingBar" Grid.RowSpan="4" IsIndeterminate="True"
                     VerticalAlignment="Top" Height="3" Visibility="Collapsed"/>
    </Grid>
</Page>
