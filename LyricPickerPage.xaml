<Page
    x:Class="HyperMedia_Lite.LyricPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource NowPlayingBackdropBrush}" RequestedTheme="Dark">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- 窄窗是默认布局：候选列表在上、歌词预览在下 -->
                <VisualState x:Name="NarrowLayout"/>
                <!-- 宽窗：左右分栏，按钮恢复常规宽度 -->
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CandidateBorder.(Grid.RowSpan)" Value="2"/>
                        <Setter Target="CandidateBorder.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="CandidateBorder.Margin" Value="0"/>
                        <Setter Target="PreviewBorder.(Grid.Row)" Value="0"/>
                        <Setter Target="PreviewBorder.(Grid.Column)" Value="1"/>
                        <Setter Target="PreviewBorder.(Grid.RowSpan)" Value="2"/>
                        <Setter Target="PreviewBorder.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="PreviewBorder.Margin" Value="10,0,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Padding="16,0" Background="#99000000">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="40" Height="34" Padding="0" Style="{StaticResource EditorIconButtonStyle}"
                        Click="Cancel_Click" ToolTipService.ToolTip="取消" AutomationProperties.Name="取消">
                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <TextBlock Text="选择歌词" FontSize="17" FontWeight="SemiBold"
                           Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#AAFFFFFF"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap"
                       Margin="8,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- 搜索区：纵向排列，宽窄窗都适用 -->
        <Border Grid.Row="1" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                Margin="16,8,16,0" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="歌名" FontSize="12" Foreground="#AAFFFFFF"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" PlaceholderText="输入歌名"
                         RequestedTheme="Dark" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="艺人" FontSize="12" Foreground="#AAFFFFFF"
                           VerticalAlignment="Center" Margin="0,8,8,0"/>
                <TextBox x:Name="ArtistBox" Grid.Row="1" Grid.Column="1" PlaceholderText="输入艺人（可选）"
                         RequestedTheme="Dark" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <ComboBox x:Name="SourceCombo" Width="130" RequestedTheme="Dark"
                              SelectedIndex="0" VerticalAlignment="Center"
                              AutomationProperties.Name="歌词来源">
                        <ComboBoxItem Content="全部来源" Tag="auto"/>
                        <ComboBoxItem Content="网易云" Tag="netease"/>
                        <ComboBoxItem Content="QQ 音乐" Tag="qq"/>
                    </ComboBox>
                    <Button x:Name="SearchButton" Content="搜索" Width="90" Margin="8,0,0,0"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Click="Search_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 候选列表 + 预览：宽窗左右分栏，窄窗上下分栏 -->
        <Grid x:Name="ContentGrid" Grid.Row="2" Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="CandidateBorder" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,0,0,6"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                <ListView x:Name="CandidateList" SelectionMode="Single"
                          SelectionChanged="CandidateList_SelectionChanged"
                          Padding="4" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Background="{StaticResource AccentBrush}"
                                            Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source}" FontSize="10" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" Margin="6,0,0,0" MaxWidth="220"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Artist}" FontSize="11"
                                           Foreground="#AAFFFFFF" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Album}" FontSize="10" Foreground="#88FFFFFF"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                    <TextBlock Text="{Binding Format}" FontSize="10" Foreground="#88FFFFFF"
                                               Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding MatchLabel}" FontSize="10"
                                               Foreground="{StaticResource AccentBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border x:Name="PreviewBorder" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,6,0,0" Padding="12"
                    Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PreviewPanel">
                        <TextBlock Text="歌词预览（完整）" FontSize="13" Foreground="#AAFFFFFF" Margin="0,0,0,8"/>
                        <TextBlock x:Name="PreviewText" FontSize="15" Foreground="White"
                                   TextWrapping="Wrap" LineHeight="23"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部操作：按权重分列，随窗口宽度伸缩，避免文字被截断 -->
        <Grid Grid.Row="3" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ResetButton" Grid.Column="0" Content="恢复默认歌词" Height="38" Margin="0,0,5,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" Foreground="White" BorderThickness="1"
                    Click="Reset_Click" ToolTipService.ToolTip="清除已选歌词，改回内嵌或本地同名歌词"
                    AutomationProperties.Name="恢复默认歌词"/>
            <Button x:Name="UseLocalButton" Grid.Column="1" Content="使用本地歌词…" Height="38" Margin="0,0,5,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" Foreground="White" BorderThickness="1"
                    Click="UseLocal_Click" ToolTipService.ToolTip="从本地 LRC / KRC / QRC / TXT 文件载入"
                    AutomationProperties.Name="使用本地歌词"/>
            <Button x:Name="CancelButton" Grid.Column="2" Content="取消" Height="38" Margin="0,0,5,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" Foreground="White" BorderThickness="1"
                    Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Grid.Column="3" Content="使用此歌词" Height="38"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    IsEnabled="False" Click="Confirm_Click"/>
        </Grid>

        <ProgressBar x:Name="LoadingBar" Grid.RowSpan="4" IsIndeterminate="True"
                     VerticalAlignment="Top" Height="3" Visibility="Collapsed"/>
    </Grid>
</Page>
