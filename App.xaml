<Application
    x:Class="HyperMedia_Lite.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HyperMedia_Lite">

    <Application.Resources>
        <!-- 全局设计令牌：Groove 风格（浅色 + 蓝色强调色，贴合参考界面） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0089D0"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF0074B3"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FFF7F7F7"/>
        <SolidColorBrush x:Key="NavForegroundBrush" Color="#FF6B6B6B"/>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF1F1F1"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF767676"/>

        <Style x:Key="EditorIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#33FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="#55FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 滑块颜色（由 ThemeService 根据强调色明暗动态调整） -->
        <SolidColorBrush x:Key="SliderFillBrush" Color="#99000000"/>
        <SolidColorBrush x:Key="SliderTrackBrush" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#FF1A1A1A"/>
        <!-- 全屏播放页（深色背景）专用 -->
        <!-- 正在播放页背景：封面主色压暗后的颜色，无封面色时回落为灰色 -->
        <SolidColorBrush x:Key="NowPlayingBackdropBrush" Color="#FF242424"/>
        <SolidColorBrush x:Key="OverlaySliderFillBrush" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="OverlaySliderTrackBrush" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="OverlaySliderThumbBrush" Color="#FFFFFFFF"/>

        <!-- 播放器滑条：自定义模板，悬停不变色 -->
        <Style x:Key="PlayerSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="{StaticResource SliderTrackBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SliderFillBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <Grid x:Name="HorizontalTemplate">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3"
                                           Height="4" VerticalAlignment="Center"
                                           Fill="{TemplateBinding Background}"/>
                                <Rectangle x:Name="HorizontalDecreaseRect" Grid.Column="0"
                                           Height="4" VerticalAlignment="Center"
                                           Fill="{TemplateBinding Foreground}"/>
                                <Thumb x:Name="HorizontalThumb" Grid.Column="1"
                                       Width="16" Height="16" VerticalAlignment="Center"
                                       Background="{StaticResource SliderThumbBrush}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{TemplateBinding Background}"
                                                     Stroke="#FFFFFFFF" StrokeThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider 模板内部画刷：让 PointerOver / Pressed 与常态同色，避免悬停变黑 -->
        <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SliderTrackFill" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#99000000"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#99000000"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#99000000"/>
        <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#99000000"/>
    </Application.Resources>

</Application>
